# Ajun Backend Configuration (Phase 1a - PostgreSQL Only)

# Production / Development Database URL (PostgreSQL Asyncpg)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/ajun_dev

# Dedicated Test Database URL (MANDATORY: Must differ from DATABASE_URL)
DATABASE_URL_TEST=postgresql+asyncpg://postgres:postgres@localhost:5432/ajun_test

# Security & Secrets (MANDATORY: JWT_SECRET must be at least 32 characters long)
JWT_SECRET=replace_with_a_super_secret_jwt_random_key_min_32_chars_now
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30
TOMBSTONE_HMAC_SECRET=replace_with_secure_tombstone_hmac_secret_key_32_chars
CRON_SECRET=replace_with_secure_random_cron_secret_for_sweeper

# CORS Configuration (MANDATORY: Comma-separated list, NEVER "*")
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Google OAuth Client IDs (Comma-separated list of accepted audience IDs)
GOOGLE_CLIENT_IDS=your_google_client_id_web.apps.googleusercontent.com,your_google_client_id_mobile.apps.googleusercontent.com

# Admin Authorization (Comma-separated list of exact email addresses)
ADMIN_EMAILS=admin@ui.ac.id,yazidmuhammadalkautsar@gmail.com

# Service Fee & Payment Flags (MANDATORY: Strictly via environment variable)
SERVICE_FEE_COINS=1
PAYMENT_ENV=sandbox
TOPUP_ENABLED=false
